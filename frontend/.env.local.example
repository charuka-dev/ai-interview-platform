# Copy this file to .env.local and fill in values before running locally.

# Base URL of the backend API — the Vite dev-server proxies /api/* to this.
# Leave as-is if running the backend locally on port 3000.
VITE_API_BASE_URL=http://localhost:3000

# Your Vapi public key — find it at https://dashboard.vapi.ai/
VITE_VAPI_PUBLIC_KEY=your_vapi_public_key_here
