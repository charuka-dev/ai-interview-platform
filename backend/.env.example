# ============================================================
# AI Interview Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database ---
# PostgreSQL connection string
# Example: postgresql://user:password@localhost:5432/interview_platform
DATABASE_URL="postgresql://postgres:password@localhost:5432/interview_platform"

# --- Redis (BullMQ Queue) ---
# If left empty, the app falls back to in-process async scoring (no Redis needed for local dev)
REDIS_URL="redis://localhost:6379"

# --- JWT ---
# Use a long, random string (min 32 chars). Generate with: openssl rand -hex 32
JWT_SECRET="replace_with_a_long_random_secret_string"
# Token expiry (e.g. "7d", "24h")
JWT_EXPIRES_IN="7d"

# --- Bcrypt ---
# Cost factor for password hashing (10-14 recommended; 12 is default)
BCRYPT_COST=12

# --- Public Server URL ---
# Must be a full https:// URL Vapi can reach for webhooks.
# Local dev: your ngrok forwarding URL (changes each time you restart ngrok).
# Production: your real deployed domain.
PUBLIC_SERVER_URL="https://your-ngrok-url.ngrok-free.app"

# --- Vapi (Voice AI Orchestration) ---
# Get from: https://dashboard.vapi.ai/
VAPI_API_KEY="vapi_..."
# Webhook secret for HMAC signature verification (set this in Vapi dashboard)
VAPI_WEBHOOK_SECRET="your_vapi_webhook_secret"

# --- Google Gemini ---
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIza..."
# Flash: used by Vapi for the live interview (must match a model Vapi
# currently supports — check Vapi's model list if this errors on
# assistant creation).
# Pro: called directly via the Gemini API for post-call scoring
# (not routed through Vapi, so not constrained by Vapi's supported list).
GEMINI_FLASH_MODEL="gemini-3.5-flash"
GEMINI_PRO_MODEL="gemini-3.1-pro"

# --- S3-Compatible Storage ---
# Local dev uses self-hosted MinIO (see docker-compose.yml).
# In production, swap these for a real provider (Cloudflare R2, AWS S3,
# Supabase Storage) — the S3-compatible API means no code changes needed,
# only these config values change.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="interview-platform"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin123"
# Signed URL expiry in seconds (default: 3600 = 1 hour)
S3_SIGNED_URL_EXPIRES=3600

# --- Rate Limiting ---
# Max session creation requests per user per time window
RATE_LIMIT_SESSIONS_MAX=10
RATE_LIMIT_SESSIONS_WINDOW_MS=3600000
# Max resume uploads per user per time window
RATE_LIMIT_RESUMES_MAX=5
RATE_LIMIT_RESUMES_WINDOW_MS=3600000

# --- Roadmap ---
# How many completed sessions before a new roadmap is generated
ROADMAP_SESSION_THRESHOLD=3

# --- Rubrics ---
# Path to rubric JSON files (defaults to src/rubrics/ relative to cwd)
# Override in production if rubrics are bundled elsewhere
# RUBRICS_DIR=/app/src/rubrics
